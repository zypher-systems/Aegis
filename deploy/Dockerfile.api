# syntax=docker/dockerfile:1

# DB-IP IP to Country Lite (CC BY 4.0). Not MaxMind GeoLite2 — that cannot
# be redistributed. Pass GEOIP_MONTH=YYYY-MM in CI to bust the download cache.
FROM debian:bookworm-slim AS geoip
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gzip \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/fetch-dbip-country.sh /fetch-dbip-country.sh
ARG GEOIP_MONTH=
RUN /bin/sh /fetch-dbip-country.sh /out/geoip/country.mmdb "$GEOIP_MONTH" \
    && chmod 0755 /out/geoip && chmod 0644 /out/geoip/country.mmdb

# Build the control-plane binary.
FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY gen ./gen
COPY internal ./internal
COPY services/api ./services/api
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOFLAGS=-buildvcs=false \
    go build -trimpath -ldflags="-s -w" -o /out/aegis-api ./services/api/cmd/aegis-api

FROM gcr.io/distroless/static-debian12:nonroot
ARG AEGIS_VERSION=1.8.0
ENV AEGIS_VERSION=$AEGIS_VERSION
ENV AEGIS_GEOIP_MMDB=/usr/share/aegis/geoip/country.mmdb
COPY --from=build /out/aegis-api /aegis-api
COPY --from=geoip --chown=nonroot:nonroot /out/geoip /usr/share/aegis/geoip
USER nonroot:nonroot
EXPOSE 8080 9443 9444
ENTRYPOINT ["/aegis-api"]
