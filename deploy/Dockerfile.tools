# Aegis toolchain — all build/test/codegen happens here. Nothing is installed
# on the host; the repo is bind-mounted in and outputs land in ./gen, ./bin,
# ./web/node_modules, etc.
FROM golang:1.27-bookworm

# Node.js 22 (LTS) for the Next.js dashboard.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates git make \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && corepack enable \
    && rm -rf /var/lib/apt/lists/*

# buf + protoc-gen-go + protoc-gen-go-grpc (pinned).
RUN GOBIN=/tools go install github.com/bufbuild/buf/cmd/buf@v1.47.2 \
    && GOBIN=/tools go install google.golang.org/protobuf/cmd/protoc-gen-go@latest \
    && GOBIN=/tools go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest
ENV PATH="/tools:${PATH}" \
    GOFLAGS="-buildvcs=false"

WORKDIR /workspace
